{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NamedUserWithRecentMFAOnly",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111122223333:user/YOUR_IAM_USER"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {"aws:MultiFactorAuthPresent": "true"},
        "NumericLessThan": {"aws:MultiFactorAuthAge": "3600"}
      }
    }
  ]
}
